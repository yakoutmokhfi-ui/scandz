# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Supabase -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# PAYMENT P3-A1 — clé service_role, réservée au code serveur de
# confiance (lib/server/*). SERVEUR UNIQUEMENT : ne JAMAIS préfixer en
# NEXT_PUBLIC_ (un préfixe NEXT_PUBLIC_ expédie la valeur à chaque
# navigateur) et ne jamais commettre la vraie valeur dans ce dépôt.
SUPABASE_SERVICE_ROLE_KEY=

# CUSTOMER TRACKING EXPERIENCE v2 — clé de chiffrement AES-256-GCM de
# la session de présentation de suivi (lib/server/tracking-session.ts),
# SERVEUR UNIQUEMENT (jamais NEXT_PUBLIC_, jamais commise). Format
# requis : 64 caractères hexadécimaux (32 octets), par ex. générée avec
# `openssl rand -hex 32`. Cette session reste STATELESS (mandat §10 :
# "no new SQL") -- ce secret est la SEULE donnée nécessaire pour la
# vérifier ; il ne remplace jamais order_id + public_token comme
# autorité de possession (mandat §9), il ne fait que sceller un jeton
# de présentation dérivé d'une preuve de possession déjà validée.
TRACKING_SESSION_SECRET=
