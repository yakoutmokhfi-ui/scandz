# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Supabase -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# PAYMENT P3-A1 — clé service_role, réservée au code serveur de
# confiance (lib/server/*). SERVEUR UNIQUEMENT : ne JAMAIS préfixer en
# NEXT_PUBLIC_ (un préfixe NEXT_PUBLIC_ expédie la valeur à chaque
# navigateur) et ne jamais commettre la vraie valeur dans ce dépôt.
SUPABASE_SERVICE_ROLE_KEY=

# CUSTOMER TRACKING EXPERIENCE v2 — clé de chiffrement AES-256-GCM de
# la session de présentation de suivi (lib/server/tracking-session.ts),
# SERVEUR UNIQUEMENT (jamais NEXT_PUBLIC_, jamais commise). Format
# requis : 64 caractères hexadécimaux (32 octets), par ex. générée avec
# `openssl rand -hex 32`. Cette session reste STATELESS (mandat §10 :
# "no new SQL") -- ce secret est la SEULE donnée nécessaire pour la
# vérifier ; il ne remplace jamais order_id + public_token comme
# autorité de possession (mandat §9), il ne fait que sceller un jeton
# de présentation dérivé d'une preuve de possession déjà validée.
TRACKING_SESSION_SECRET=

# ============================================================
# PAYMENT STREAM B — MONETICO FINALIZATION.
#
# Variables RÉELLEMENT lues par le runtime de paiement (audit exhaustif
# de ce lot, aucune supposée) -- AUCUNE ne contient jamais le TPE/
# société/clé de sécurité Monetico eux-mêmes (ceux-ci sont stockés
# côté base, via le coffre Vault, jamais en variable d'environnement --
# voir lib/server/payment-service.ts::getPaymentProviderCredential).
# Ne JAMAIS y mettre le mot de passe personnel du tableau de bord
# Monetico d'Emmanuel -- ce coffre ne stocke que les identifiants
# TECHNIQUES d'intégration (TPE/société/clé de sécurité), jamais un
# identifiant/mot de passe humain de portail (voir fiche paramètres
# Monetico Online Starter, note 6 : seul le contact commercial reçoit
# ce mot de passe humain, JAMAIS requis par Scanym).
# ============================================================

# Coupe-circuit d'urgence du runtime de paiement -- SEULE la chaîne
# EXACTE "true" active le checkout Monetico (lib/server/payment-
# checkout-runtime.ts). Toute autre valeur (absente, vide, "false",
# etc.) désactive le checkout de façon fermée -- utilisable comme
# désactivation immédiate en cas d'incident, sans redéploiement de
# code. Valeur de développement/test sûre : laisser VIDE ou "false"
# (checkout désactivé par défaut) ; ne PAS positionner "true" avant
# une décision explicite CIO GO.
PAYMENT_CHECKOUT_RUNTIME_ENABLED=

# Secret d'invocation MANUELLE du worker de reprise de paiement (en-
# tête X-Payment-Recovery-Worker-Secret, app/api/internal/payments/
# monetico/recover/route.ts, verbe POST UNIQUEMENT). STRUCTURELLEMENT
# DISTINCT de CRON_SECRET ci-dessous -- jamais interchangeable (preuve
# par test, tests/v136-payment-p3bmcr-v45-cron-auth-separation.test.ts).
# Jamais la clé MAC Monetico, jamais le public_token client.
PAYMENT_RECOVERY_WORKER_SECRET=

# Secret d'invocation PLANIFIÉE (Vercel Cron natif) du même worker de
# reprise (en-tête Authorization: Bearer <CRON_SECRET>, verbe GET
# UNIQUEMENT). Vercel l'injecte automatiquement pour les invocations
# planifiées lorsque cette variable est configurée sur le projet --
# aucune configuration d'en-tête personnalisé n'est possible côté
# vercel.json lui-même. Voir OPEN-ARCHITECTURE-GAPS / prérequis
# externe : le plan Vercel Production doit supporter la cadence cron
# auditée (voir vercel.json) avant toute activation CIO GO.
CRON_SECRET=

# Version de clé ACTIVE pour la rotation du jeton de relais de retour
# signé (lib/server/payment-return-relay.ts) -- entier positif sous
# forme de chaîne (ex. "1"). Absente ou invalide -> échec fermé
# explicite (aucune valeur par défaut devinée). Change UNIQUEMENT lors
# d'une rotation de clé délibérée, jamais automatiquement.
PAYMENT_RETURN_RELAY_ACTIVE_KEY_VERSION=
