+  const imports = [...generatorSrc.matchAll(/^(?:import|from) ([A-Za-z0-9_.]+)/gm)].map(
+    (m) => m[1]!
+  );
+  assert.ok(imports.length > 0, "le générateur doit déclarer ses imports");
+  const STDLIB = new Set([
+    "datetime",
+    "json",
+    "platform",
+    "re",
+    "sys",
+    "zoneinfo",
+    "pathlib",
+  ]);
+  for (const name of imports) {
+    assert.ok(
+      STDLIB.has(name.split(".")[0]!),
