+++sql_value "delete from public.restaurant_fulfillment_schedule where restaurant_id='$RID_A';" >/dev/null
+++
+++# ============================================================
+++# [17] ZÉRO UUID RÉSERVÉ
+++# ============================================================
+++log "=== [17] Le zéro UUID est une sentinelle réservée ==="
+++assert_eq "[17a] la RPC refuse une règle au zéro UUID, en la nommant" "REFUSE" \
+++  "$(refused "$(outcome_as authenticated "$OWNER_A" "select public.mutate_merchant_fulfillment_schedule('$RID_A','save_schedule','{\"modeCode\":\"delivery\",\"timezone\":\"Europe/Paris\",\"fulfillmentRuleId\":\"$NIL_RULE\"}'::jsonb);")")"
+++assert_eq "[17b] la CONTRAINTE DE TABLE la refuse aussi" "REFUSE" \
+++  "$(refused "$(outcome_owner "insert into public.restaurant_fulfillment_schedule (restaurant_id, mode_code, fulfillment_rule_id, timezone) values ('$RID_A','delivery','$NIL_RULE','Europe/Paris');")")"
+++
+++# ============================================================
+++# [18] CSDJ1-AUD-05 — ANTI-DÉRIVE EXACT, PROUVÉ PAR MUTATION
+++#      CSDJ-V1-RESOLVER-EXACT-SHAPE-01
+++#
+++# Chaque mutation remplace l'autorité de tarification par un SOSIE dans
+++# une base jetable propre, applique le lot, et exige :
+++#   - que l'application ÉCHOUE,
+++#   - avec SCANYM_SCHEMA_DRIFT,
+++#   - et qu'AUCUN objet du lot n'ait été créé -- le refus doit tomber
+++#     AVANT toute création, pas à la première lecture en production.
+++# ============================================================
+++log "=== [18] Anti-dérive exact : mutations du résolveur ==="
+++RESOLVER_SIG="public.resolve_delivery_fulfillment(uuid,text,text,integer,numeric)"
+++
+++mutate_resolver_and_apply() {
+++  local label="$1" returns="$2" db="scanym_csdj1_mut$3_$RUN_TAG"
+++  create_tracked_db "$db" -T "$DB_BASE"
+++  psql -X -q -d "$db" -v ON_ERROR_STOP=1 >/dev/null 2>"$ERR" <<SQL
+++drop function $RESOLVER_SIG;
+++create function public.resolve_delivery_fulfillment(
+++  p_restaurant_id uuid, p_mode_code text, p_postal_code text, p_total_count integer, p_subtotal numeric default null
+++) returns table ($returns)
+++language plpgsql stable security definer set search_path = ''
+++as \$f\$ begin return; end \$f\$;
+++SQL
+++  if [ $? -ne 0 ]; then
+++    fail "[18] $label — sosie impossible à injecter : $(head -2 "$ERR" | tr '\n' ' ')"
+++    return
+++  fi
+++  if apply_path "$SUPABASE_DIR/$LOT_SQL" "$db"; then
+++    fail "[18] $label — le lot s'est appliqué sur une forme de résolveur INCOMPATIBLE"
+++  else
+++    if grep -q 'SCANYM_SCHEMA_DRIFT' "$OUT"; then
+++      pass "[18] $label — refusé, et le refus nomme la dérive de schéma"
+++    else
+++      fail "[18] $label — refusé, mais pas pour la bonne raison : $(tail -3 "$OUT" | tr '\n' ' ')"
+++    fi
+++  fi
+++  assert_eq "[18] $label — AUCUN objet du lot créé avant le refus" "0" \
+++    "$(sql_on "$db" "select count(*) from pg_class where relnamespace='public'::regnamespace and relname like 'restaurant_fulfillment_schedule%';")"
+++}
+++
+++# CONTRÔLE POSITIF — une forme CONFORME doit s'appliquer, sinon le garde
+++# refuserait tout et ne prouverait rien.
+++GOOD_RETURNS="eligible boolean, fulfillment_rule_id uuid, fulfillment_code text, provider text, matched_prefix text, zone_prefixes text[], is_fallback boolean, min_items integer, customer_text text, display_order integer, pricing_mode text, fixed_fee numeric, free_threshold numeric, delivery_fee numeric, block text, missing integer"
+++DB_POS="scanym_csdj1_mutpos_$RUN_TAG"
+++create_tracked_db "$DB_POS" -T "$DB_BASE"
+++psql -X -q -d "$DB_POS" -v ON_ERROR_STOP=1 >/dev/null 2>&1 <<SQL
+++drop function $RESOLVER_SIG;
+++create function public.resolve_delivery_fulfillment(
+++  p_restaurant_id uuid, p_mode_code text, p_postal_code text, p_total_count integer, p_subtotal numeric default null
+++) returns table ($GOOD_RETURNS)
+++language plpgsql stable security definer set search_path = ''
+++as \$f\$ begin return; end \$f\$;
+++SQL
+++if apply_path "$SUPABASE_DIR/$LOT_SQL" "$DB_POS"; then
+++  pass "[18] CONTRÔLE POSITIF — une forme conforme s'applique (le garde ne refuse pas tout)"
+++else
+++  fail "[18] CONTRÔLE POSITIF — une forme conforme est refusée : $(tail -3 "$OUT" | tr '\n' ' ')"
+++fi
+++
+++# Mutation 1 : colonne RENOMMÉE en SOSIE qui CONTIENT le nom attendu.
+++#   C'est le défaut exact de l'audit : « not_eligible » contient
+++#   « eligible », « not_block » contient « block ».
+++mutate_resolver_and_apply "SOSIE par sous-chaîne (not_eligible / not_block)" \
+++  "not_eligible boolean, fulfillment_rule_id uuid, min_items integer, missing integer, customer_text text, pricing_mode text, fixed_fee numeric, free_threshold numeric, delivery_fee numeric, not_block text" "sub"
+++# Mutation 2 : colonne simplement RENOMMÉE.
+++mutate_resolver_and_apply "colonne RENOMMÉE (is_eligible)" \
+++  "is_eligible boolean, block text, fulfillment_rule_id uuid, min_items integer, missing integer, customer_text text, pricing_mode text, fixed_fee numeric, free_threshold numeric, delivery_fee numeric" "ren"
+++# Mutation 3 : bon nom, MAUVAIS type.
+++mutate_resolver_and_apply "MAUVAIS type (delivery_fee en text)" \
+++  "eligible boolean, block text, fulfillment_rule_id uuid, min_items integer, missing integer, customer_text text, pricing_mode text, fixed_fee numeric, free_threshold numeric, delivery_fee text" "typ"
+++# Mutation 4 : colonne ABSENTE.
+++mutate_resolver_and_apply "colonne ABSENTE (free_threshold retirée)" \
+++  "eligible boolean, block text, fulfillment_rule_id uuid, min_items integer, missing integer, customer_text text, pricing_mode text, fixed_fee numeric, delivery_fee numeric" "abs"
+++# Mutation 5 : SURCHARGE supplémentaire -- le contrôle deviendrait
+++#   ambigu, et l'appel du lot imprévisible.
+++DB_DUP="scanym_csdj1_mutdup_$RUN_TAG"
+++create_tracked_db "$DB_DUP" -T "$DB_BASE"
+++psql -X -q -d "$DB_DUP" -v ON_ERROR_STOP=1 >/dev/null 2>&1 <<SQL
+++create function public.resolve_delivery_fulfillment(p_restaurant_id uuid)
+++returns table (eligible boolean)
+++language plpgsql stable set search_path = ''
+++as \$f\$ begin return; end \$f\$;
+++SQL
+++if apply_path "$SUPABASE_DIR/$LOT_SQL" "$DB_DUP"; then
+++  fail "[18] SURCHARGE supplémentaire — le lot s'est appliqué malgré deux résolveurs"
+++else
+++  if grep -q 'SCANYM_SCHEMA_DRIFT' "$OUT"; then
+++    pass "[18] SURCHARGE supplémentaire — refusée, et le refus nomme la dérive"
+++  else
+++    fail "[18] SURCHARGE supplémentaire — refusée pour une autre raison : $(tail -3 "$OUT" | tr '\n' ' ')"
+++  fi
+++fi
+++DB="$DB_FWD"
+++
+++# ============================================================
+++# [13][14] ROLLBACK
+++# ============================================================
+++log "=== [13][14] Retour arrière ==="
+++clone_base "$DB_RB"
+++apply_path "$SUPABASE_DIR/$LOT_SQL" "$DB_RB" >/dev/null 2>&1 || fatal "aller sur la base de rollback"
+++RB_AFTER_FWD="$(schema_counts "$DB_RB")"
+++# [14] d'abord : avec une table d'instantané de CSDJ-3 présente, le
+++# retour doit REFUSER plutôt que casser un historique.
+++sql_on "$DB_RB" "create table public.order_fulfillment_schedule_snapshot (order_id uuid primary key);" >/dev/null
+++if apply_path "$SUPABASE_DIR/$LOT_ROLLBACK" "$DB_RB"; then
+++  fail "[14] le retour s'est appliqué malgré un instantané de CSDJ-3 présent"
+++else
+++  if grep -q 'SCANYM_ROLLBACK_REFUSED' "$OUT"; then
+++    pass "[14] le retour REFUSE de passer sous un instantané de CSDJ-3, en nommant la cause"
+++  else
+++    fail "[14] le retour a échoué, mais pas pour la bonne raison : $(tail -3 "$OUT" | tr '\n' ' ')"
+++  fi
+++fi
+++assert_eq "[14a] et les tables du lot sont TOUJOURS là après ce refus" "4" \
+++  "$(sql_on "$DB_RB" "select count(*) from pg_class where relnamespace='public'::regnamespace and relkind='r' and relname like 'restaurant_fulfillment_schedule%';")"
+++sql_on "$DB_RB" "drop table public.order_fulfillment_schedule_snapshot;" >/dev/null
+++# [13] ensuite : le retour nominal.
+++if apply_path "$SUPABASE_DIR/$LOT_ROLLBACK" "$DB_RB"; then
+++  pass "[13] le retour s'applique"
+++else
+++  fail "[13] le retour ÉCHOUE : $(tail -5 "$OUT" | tr '\n' ' ')"
+++fi
+++assert_eq "[13a] aucune table du lot ne subsiste" "0" \
+++  "$(sql_on "$DB_RB" "select count(*) from pg_class where relnamespace='public'::regnamespace and relname like 'restaurant_fulfillment_schedule%';")"
+++assert_eq "[13b] aucune fonction du lot ne subsiste" "0" \
+++  "$(sql_on "$DB_RB" "select count(*) from pg_proc where pronamespace='public'::regnamespace and (proname like 'checkout_date%' or proname like 'checkout_slot%' or proname like 'checkout_schedule%' or proname like 'checkout_unfulfillable%' or proname like '%fulfillment_schedule%');")"
+++assert_eq "[13c] l'état PRÉDÉCESSEUR est restauré à l'identique" "$BASE_COUNTS" \
+++  "$(schema_counts "$DB_RB")"
+++assert_eq "[13d] create_order est intacte après le retour" "$BASE_CO_FP" \
+++  "$(fn_code_fingerprint 'create_order' "$DB_RB")"
+++assert_eq "[13e] l'autorité de tarification est intacte après le retour" "$BASE_RESOLVER_FP" \
+++  "$(fn_code_fingerprint 'resolve_delivery_fulfillment' "$DB_RB")"
+++assert_eq "[13f] un second retour est REFUSÉ, il ne réussit pas en silence" "REFUSE" \
+++  "$(if apply_path "$SUPABASE_DIR/$LOT_ROLLBACK" "$DB_RB"; then echo AUTORISE; else grep -q 'SCANYM_ALREADY_REVERTED' "$OUT" && echo REFUSE || echo "ECHEC_AUTRE"; fi)"
+++# Une seconde application de l'ALLER est refusée elle aussi.
+++assert_eq "[13g] une seconde application de l'aller est REFUSÉE" "REFUSE" \
+++  "$(if apply_path "$SUPABASE_DIR/$LOT_SQL" "$DB_FWD"; then echo AUTORISE; else grep -q 'SCANYM_ALREADY_APPLIED' "$OUT" && echo REFUSE || echo "ECHEC_AUTRE"; fi)"
+++
+++log "=== BILAN : $PASS_COUNT preuve(s) produite(s), $FAIL_COUNT échec(s) ==="
+++[ "$FAIL_COUNT" -eq 0 ] || exit 1
+++exit 0
++diff --git a/supabase/tests/checkout-scheduling-foundation-v1-role-restoration-check.sh b/supabase/tests/checkout-scheduling-foundation-v1-role-restoration-check.sh
++new file mode 100755
++index 0000000..ade4785
++--- /dev/null
+++++ b/supabase/tests/checkout-scheduling-foundation-v1-role-restoration-check.sh
++@@ -0,0 +1,206 @@
+++#!/usr/bin/env bash
+++# ============================================================
+++# Scanym — CHECKOUT SCHEDULING FOUNDATION v1 (CSDJ-1)
+++# Harnais de SÛRETÉ dédié : RESTAURATION EXACTE DES ATTRIBUTS DE RÔLE.
+++#
+++# Ferme CSDJ1-AUD-06.
+++#
+++# ------------------------------------------------------------------
+++# LE DÉFAUT QUE CE FICHIER PROUVE FERMÉ
+++#
+++# `boolean::text` rend « true »/« false » en SQL ; « t »/« f » est la
+++# forme de l'affichage ALIGNÉ de psql, pas celle de la conversion. Le
+++# harnais principal capturait donc « true » et comparait à « t » : la
+++# comparaison échouait TOUJOURS, et la branche de repli restaurait
+++# NOLOGIN NOBYPASSRLS.
+++#
+++# Sur un cluster jetable que le harnais crée lui-même, c'était
+++# invisible : le cluster entier disparaît juste après. Mais en mode
+++# CLUSTER DÉSIGNÉ par l'opérateur (SCANYM_HARNESS_PGHOST), le nettoyage
+++# restaure réellement les rôles du cluster de l'opérateur -- et il les
+++# corrompait.
+++#
+++# ------------------------------------------------------------------
+++# CE QUE CE HARNAIS PROUVE (exécuté, jamais inspecté)
+++#
+++# Pour les QUATRE combinaisons initiales de LOGIN × BYPASSRLS, sur les
+++# trois rôles applicatifs, dans un cluster DÉSIGNÉ :
+++#   - le harnais principal s'exécute jusqu'au bout ;
+++#   - après son nettoyage, CHAQUE attribut de CHAQUE rôle est
+++#     exactement celui d'avant l'exécution.
+++# Plus deux contrôles de forme :
+++#   - l'instantané est bien encodé en 1/0, et non en true/false ;
+++#   - un instantané d'une autre forme fait REFUSER l'exécution, plutôt
+++#     que de laisser muter un cluster non restaurable.
+++#
+++# CE QUE CE HARNAIS NE FAIT PAS : il ne touche aucun cluster qu'il n'a
+++# pas créé lui-même, n'accepte aucune variable de connexion héritée, et
+++# ne journalise aucune valeur de variable.
+++#
+++# Usage :  SCANYM_DISPOSABLE_CLUSTER=1 \
+++#            bash supabase/tests/checkout-scheduling-foundation-v1-role-restoration-check.sh
+++# ============================================================
+++set -u
+++
+++SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+++HARNESS="$SCRIPT_DIR/checkout-scheduling-foundation-v1-check.sh"
+++[ -f "$HARNESS" ] || { echo "harnais principal introuvable" >&2; exit 1; }
+++
+++PASS=0
+++FAIL=0
+++log()  { printf '[%s] %s\n' "$(date -u '+%H:%M:%S')" "$*"; }
+++pass() { PASS=$((PASS + 1)); log "PASS: $*"; }
+++fail() { FAIL=$((FAIL + 1)); log "FAIL: $*"; }
+++fatal() { log "FATAL: $*"; exit 1; }
+++
+++# Ce fichier démarre lui aussi un cluster jetable : il exige le même
+++# consentement explicite que le harnais qu'il met à l'épreuve.
+++if [ "${SCANYM_DISPOSABLE_CLUSTER:-}" != "1" ]; then
+++  log "REFUS : SCANYM_DISPOSABLE_CLUSTER=1 requis (ce fichier démarre un cluster jetable)."
+++  exit 2
+++fi
+++[ "$(id -u)" != "0" ] || fatal "initdb refuse de s'exécuter en root."
+++
+++TMP_DIR="$(mktemp -d)"
+++PGDATA_DIR="$TMP_DIR/cluster"
+++SOCKET_DIR="$TMP_DIR/sock"
+++PORT=$(( 49152 + ($$ % 15000) ))
+++CLUSTER_UP=0
+++
+++cleanup() {
+++  local rc=$?
+++  [ "$CLUSTER_UP" = "1" ] && "$PG_CTL" -D "$PGDATA_DIR" stop -m immediate >/dev/null 2>&1
+++  rm -rf "$TMP_DIR"
+++  exit "$rc"
+++}
+++trap cleanup EXIT
+++
+++INITDB=""
+++for cand in initdb /usr/lib/postgresql/*/bin/initdb; do
+++  if command -v "$cand" >/dev/null 2>&1; then INITDB="$cand"; break; fi
+++done
+++[ -n "$INITDB" ] || fatal "initdb introuvable."
+++PG_CTL="$(dirname "$INITDB")/pg_ctl"
+++[ -x "$PG_CTL" ] || PG_CTL="pg_ctl"
+++
+++mkdir -p "$SOCKET_DIR"
+++"$INITDB" -D "$PGDATA_DIR" -A trust -E UTF8 --locale=C >"$TMP_DIR/initdb.log" 2>&1 \
+++  || fatal "initdb a échoué : $(tail -3 "$TMP_DIR/initdb.log" | tr '\n' ' ')"
+++"$PG_CTL" -D "$PGDATA_DIR" -l "$TMP_DIR/pg.log" \
+++  -o "-p $PORT -k $SOCKET_DIR -c listen_addresses=''" start >/dev/null 2>&1 \
+++  || fatal "démarrage impossible : $(tail -3 "$TMP_DIR/pg.log" 2>/dev/null | tr '\n' ' ')"
+++CLUSTER_UP=1
+++log "cluster TÉMOIN créé par CE fichier (socket $SOCKET_DIR, port $PORT)."
+++
+++q() { psql -X -A -q -t -h "$SOCKET_DIR" -p "$PORT" -d postgres -c "$1" </dev/null 2>/dev/null | tail -1 | tr -d ' '; }
+++
+++# État d'un rôle sous une forme COMPARABLE, indépendante de toute
+++# convention d'affichage.
+++role_attrs() {
+++  q "select coalesce((select (case when rolcanlogin then 'LOGIN' else 'NOLOGIN' end)
+++                           || '+' ||
+++                             (case when rolbypassrls then 'BYPASSRLS' else 'NOBYPASSRLS' end)
+++                      from pg_roles where rolname = '$1'), 'ABSENT');"
+++}
+++
+++APP_ROLES="anon authenticated service_role"
+++
+++run_main_harness() {
+++  # `env -i` : on part d'un environnement VIDE et on n'injecte QUE le
+++  # consentement et la désignation du cluster. Aucune variable héritée
+++  # ne peut donc influencer l'exécution.
+++  env -i PATH="$PATH" HOME="${HOME:-/tmp}" \
+++    SCANYM_DISPOSABLE_CLUSTER=1 \
+++    SCANYM_HARNESS_PGHOST="$SOCKET_DIR" \
+++    SCANYM_HARNESS_PGPORT="$PORT" \
+++    bash "$HARNESS" >"$TMP_DIR/main.log" 2>&1
+++  return $?
+++}
+++
+++# ------------------------------------------------------------------
+++# [A] Les QUATRE combinaisons initiales
+++# ------------------------------------------------------------------
+++for combo in "NOLOGIN NOBYPASSRLS" "LOGIN NOBYPASSRLS" "NOLOGIN BYPASSRLS" "LOGIN BYPASSRLS"; do
+++  set -- $combo
+++  LK="$1"; BK="$2"
+++  log "=== [A] état initial des rôles : $LK + $BK ==="
+++
+++  for r in $APP_ROLES; do
+++    q "do \$\$ begin
+++         if not exists (select 1 from pg_roles where rolname='$r') then
+++           execute 'create role $r $LK $BK';
+++         else
+++           execute 'alter role $r $LK $BK';
+++         end if;
+++       end \$\$;" >/dev/null
+++  done
+++
+++  declare -A BEFORE=()
+++  for r in $APP_ROLES; do BEFORE[$r]="$(role_attrs "$r")"; done
+++  log "  avant : $(for r in $APP_ROLES; do printf '%s=%s ' "$r" "${BEFORE[$r]}"; done)"
+++
+++  if run_main_harness; then
+++    pass "[A] $LK+$BK — le harnais principal s'exécute jusqu'au bout sur le cluster désigné"
+++  else
+++    fail "[A] $LK+$BK — le harnais principal a échoué : $(tail -3 "$TMP_DIR/main.log" | tr '\n' ' ')"
+++  fi
+++
+++  for r in $APP_ROLES; do
+++    after="$(role_attrs "$r")"
+++    if [ "$after" = "${BEFORE[$r]}" ]; then
+++      pass "[A] $LK+$BK — '$r' restauré EXACTEMENT ($after)"
+++    else
+++      fail "[A] $LK+$BK — '$r' corrompu : avant '${BEFORE[$r]}', après '$after'"
+++    fi
+++  done
+++done
+++
+++# ------------------------------------------------------------------
+++# [B] Forme de l'instantané : 1/0, jamais true/false ni t/f
+++# ------------------------------------------------------------------
+++log "=== [B] forme de l'instantané de rôle ==="
+++SNAP_EXPR="$(grep -A3 '^role_state()' "$HARNESS" | tr -d '\n')"
+++case "$SNAP_EXPR" in
+++  *"then '1' else '0'"*) pass "[B] l'instantané encode explicitement 1/0" ;;
+++  *) fail "[B] l'instantané n'encode pas 1/0 — la comparaison du nettoyage redeviendrait fragile" ;;
+++esac
+++case "$SNAP_EXPR" in
+++  *"rolcanlogin::text"*) fail "[B] l'instantané emploie encore ::text, dont la forme est 'true'/'false'" ;;
+++  *) pass "[B] l'instantané n'emploie plus ::text sur un booléen" ;;
+++esac
+++if grep -q '\[ "\$login" = "1" \]' "$HARNESS" && grep -q '\[ "\$bypass" = "1" \]' "$HARNESS"; then
+++  pass "[B] la restauration compare bien à 1, et non à 't'"
+++else
+++  fail "[B] la restauration ne compare pas à 1 — l'écart entre capture et comparaison subsiste"
+++fi
+++if grep -q "'EXISTS|1|1'" "$HARNESS"; then
+++  pass "[B] le verrou de sûreté n'accepte que les quatre instantanés bien formés"
+++else
+++  fail "[B] le verrou de sûreté n'énumère pas les instantanés admissibles"
+++fi
+++
+++# ------------------------------------------------------------------
+++# [C] Un rôle ABSENT avant l'exécution est RETIRÉ après
+++# ------------------------------------------------------------------
+++log "=== [C] un rôle absent avant doit être absent après ==="
+++q "drop role if exists service_role;" >/dev/null
+++BEFORE_ABSENT="$(role_attrs service_role)"
