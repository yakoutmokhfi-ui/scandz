+++    granularity = cfg.get("timeGranularityMinutes")
+++    if slot_mode == "time_within_window" and granularity is None:
+++        return {"status": "unfulfillable", "reason": "granularity_missing",
+++                "firstEligibleDate": NIL, "dates": []}
