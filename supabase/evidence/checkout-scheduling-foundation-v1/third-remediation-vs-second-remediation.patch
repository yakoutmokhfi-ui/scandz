+        `(oracle : ${named.expected}) -- s'il tombe juste, ce contrôle ne prouve rien`
+    );
+
+    // Et l'implémentation livrée, elle, est du côté de l'oracle.
+    assert.equal(
+      resolveWallTime(y, mo, d, minutesOf(named.time), named.zone).status,
