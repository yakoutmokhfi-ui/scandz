+++def resolve(case):
+++    cfg = case["config"]
+++    if cfg is None or cfg.get("enabled") is not True:
+++        return {"status": "absent", "reason": NIL, "firstEligibleDate": NIL, "dates": []}
+++
+++    date_mode = cfg["dateSelectionMode"]
