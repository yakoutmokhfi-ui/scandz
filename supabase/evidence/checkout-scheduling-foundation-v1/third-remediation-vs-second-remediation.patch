+++      [2026, 3, 29],
+++      [2026, 10, 25],
+++    ] as const) {
+++      for (const minutes of [0, 120, 150, 180, 1439]) {
+++        assert.equal(
+++          resolveWallTime(date[0], date[1], date[2], minutes, tz).status,
+++          "ok",
+++          `${tz} ${date.join("-")} ${minutes}`
+++        );
+++      }
+++    }
+++  }
+++});
