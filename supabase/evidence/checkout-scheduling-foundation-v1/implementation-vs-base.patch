+assert_eq "[5c] staff est REFUSÉ" "REFUSE" \
+  "$(refused "$(outcome_as authenticated "$STAFF_A" "select public.mutate_merchant_fulfillment_schedule('$RID_A','save_schedule','$PAYLOAD_OK'::jsonb);")")"
