+  const { cats, loadedView, rows } = auditState();
+  assert.deepEqual(loadedView.map((e) => e.id), ["comte", "beaufort", "abondance"]);
+  // L'ordre qui fait autorité est devenu Beaufort, Comté, Abondance.
