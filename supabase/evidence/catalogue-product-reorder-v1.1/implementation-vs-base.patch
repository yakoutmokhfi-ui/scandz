+  // Le tirage a réellement exercé chaque issue, et les cas qui comptent.
+  t.diagnostic(`scénarios comparés (SQL réel == modèle) : ${SCENARIOS} -- ${JSON.stringify({ ...counts, acceptedWithTies, staleButSameIds, inserted })}`);
