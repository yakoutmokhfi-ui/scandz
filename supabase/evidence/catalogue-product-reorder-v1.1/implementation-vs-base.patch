+      ('${P.zeste}',   '${CAT_FROMAGES}', '${SUB_CHEVRES}', 'Zeste de chèvre', 0, true,  null),
+      ('${P.eclat}',   '${CAT_FROMAGES}', '${SUB_CHEVRES}', 'éclat cendré',    0, true,  null),
+      ('${P.banon}',   '${CAT_FROMAGES}', '${SUB_CHEVRES}', 'Banon',           0, true,  null),
