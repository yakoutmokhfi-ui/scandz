+async function waitFor(check: () => boolean, timeoutMs = 3000, intervalMs = 20): Promise<void> {
+  const start = Date.now();
+  while (!check()) {
+    if (Date.now() - start > timeoutMs) return;
+    await new Promise((r) => setTimeout(r, intervalMs));
+  }
