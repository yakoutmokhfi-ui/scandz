+test("[BO1-R1-13] une règle d'un autre marchand, ou jamais déclarée, est refusée : la portée ne s'invente pas", () => {
+  const backend = new FakeFulfillmentWriteBackend();
+  const r1 = merchantWithThirdPartyDeliveries();
