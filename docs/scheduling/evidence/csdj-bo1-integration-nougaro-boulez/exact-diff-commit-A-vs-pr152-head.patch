+test("[BO1-R1-14] aucune règle d'Au Lait Cru ne devient un défaut global : un marchand vierge ne lit rien", () => {
+  const backend = new FakeFulfillmentWriteBackend();
+  backend.setTenant("alc", auLaitCruPickupFixture());
