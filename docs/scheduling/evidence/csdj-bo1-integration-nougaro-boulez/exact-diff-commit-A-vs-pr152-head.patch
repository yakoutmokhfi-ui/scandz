+test("[BO1-R1-4] bornes du contrat : 100 fenêtres, 200 créneaux, 731 fermetures — refusées avant l'envoi", () => {
+  const windows = (n: number) =>
+    Array.from({ length: n }, (_, i) => ({
+      rowId: `w${i}`,
