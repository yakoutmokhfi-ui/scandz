+  // r2 ne déclare pas la règle : refus, rien n'est créé chez lui.
+  assert.throws(() => backend.save("r2", payload), /CSDJ1_FOREIGN_RULE/);
+  assert.deepEqual([backend.snapshot("r1"), backend.snapshot("r2")], before);
+});
